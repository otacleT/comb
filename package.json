{
  "name": "@otaclet/comb",
  "version": "0.1.0",
  "description": "From tangled ideas to decided specs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otacleT/comb.git"
  },
  "keywords": [
    "spec-driven-development",
    "claude-code",
    "specs",
    "cli",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "comb": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
